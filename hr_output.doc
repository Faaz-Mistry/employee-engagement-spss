\cellx6208\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 Syntax
\cell\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=Department MonthlyIncome MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: Department=col(source(s), name("Department"), unit.category())\par   DATA: MonthlyIncome=col(source(s), name("MonthlyIncome"))\par   DATA: id=col(source(s), name("$CASENUM"), unit.category())\par   GUIDE: axis(dim(1), label("Department"))\par   GUIDE: axis(dim(2), label("Monthly income"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: schema(position(bin.quantile.letter(Department*MonthlyIncome)), label(id))\par END GPL.
