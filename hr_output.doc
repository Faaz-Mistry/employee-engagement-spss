\cellx6208\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 Syntax
\cell\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=tenure_band MEANCI(JobSatisfaction, 95)[name="MEAN_JobSatisfaction" LOW="MEAN_JobSatisfaction_LOW" HIGH="MEAN_JobSatisfaction_HIGH"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: tenure_band=col(source(s), name("tenure_band"), unit.category())\par   DATA: MEAN_JobSatisfaction=col(source(s), name("MEAN_JobSatisfaction"))\par   DATA: LOW=col(source(s), name("MEAN_JobSatisfaction_LOW"))\par   DATA: HIGH=col(source(s), name("MEAN_JobSatisfaction_HIGH"))\par   GUIDE: axis(dim(1), label("tenure_band"))\par   GUIDE: axis(dim(2), label("Mean Job satisfaction"))\par   GUIDE: text.title(label("Mean job satisfaction by tenure"))\par   SCALE: cat(dim(1), include("1.00", "2.00", "3.00", "4.00"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(tenure_band*MEAN_JobSatisfaction), shape.interior(shape.square))\par   ELEMENT: interval(position(region.spread.range(tenure_band*(LOW+HIGH))), shape.interior(shape.ibeam))\par END GPL.
