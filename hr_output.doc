\pard\pard\plain\sl400\f0 \par \pard\plain\s0\ql\fi0\li0\ri0\plain\f1\fs20\cf0 * Chart Builder.\par GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=Department MEANCI(JobSatisfaction, 95)[name="MEAN_JobSatisfaction" LOW="MEAN_JobSatisfaction_LOW" HIGH="MEAN_JobSatisfaction_HIGH"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: Department=col(source(s), name("Department"), unit.category())\par   DATA: MEAN_JobSatisfaction=col(source(s), name("MEAN_JobSatisfaction"))\par   DATA: LOW=col(source(s), name("MEAN_JobSatisfaction_LOW"))\par   DATA: HIGH=col(source(s), name("MEAN_JobSatisfaction_HIGH"))\par   GUIDE: axis(dim(1), label("Department"))\par   GUIDE: axis(dim(2), label("Mean Job satisfaction"))\par   GUIDE: text.title(label("Mean job satisfaction by department"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(Department*MEAN_JobSatisfaction), shape.interior(shape.square))\par   ELEMENT: interval(position(region.spread.range(Department*(LOW+HIGH))), shape.interior(shape.ibeam))\par END GPL.\par \par
\pard\plain\sl400\f0 \par \pard\plain\sl400\f0 \par \pard\plain\s0\ql\fi0\li0\ri0\plain\f3\fs26\b\cf0 \par GGraph\par \b0\par
